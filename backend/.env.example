# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/expense_tracker

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Email (used for monthly report emails)
# For Gmail: enable 2FA and create an "App Password" -> https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="Expense Tracker <your_email@gmail.com>"

# Cron schedule for monthly report email (default: 8 AM on the 1st of every month)
MONTHLY_REPORT_CRON=0 8 1 * *
